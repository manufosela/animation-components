{
  "name": "@manufosela/scene-protonimg",
  "version": "2.0.0",
  "description": "Proton-based particle animation that morphs between two images, built with Lit 3",
  "license": "MIT",
  "author": "manufosela",
  "type": "module",
  "main": "./src/scene-protonimg.js",
  "module": "./src/scene-protonimg.js",
  "types": "./src/scene-protonimg.d.ts",
  "exports": {
    ".": {
      "types": "./src/scene-protonimg.d.ts",
      "import": "./src/scene-protonimg.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "web-dev-server --node-resolve --open demo/ --watch",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "test:coverage": "web-test-runner --coverage",
    "build:types": "tsc --declaration --declarationMap --emitDeclarationOnly --allowJs --checkJs --outDir ./src ./src/scene-protonimg.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manufosela/animation-components",
    "directory": "packages/scene-protonimg"
  },
  "keywords": [
    "web-components",
    "lit",
    "animation",
    "proton",
    "particles",
    "canvas"
  ],
  "homepage": "https://github.com/manufosela/animation-components/tree/main/packages/scene-protonimg#readme",
  "bugs": {
    "url": "https://github.com/manufosela/animation-components/issues"
  },
  "dependencies": {
    "lit": "^3.2.1"
  }
}
